{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LiteQueue": {
    "Redis": {
      "ConnectionString": "localhost:6379",
      "Database": 0,
      "KeyPrefix": "litequeue"
    },
    "Defaults": {
      "VisibilityTimeoutSeconds": 60,
      "MaxDeliveryAttempts": 5,
      "MessageRetentionHours": 72,
      "DeadLetterRetentionDays": 14,
      "LongPollingSeconds": 20,
      "MaximumMessageSizeBytes": 262144
    },
    "Workers": {
      "DelayedMessageIntervalMilliseconds": 1000,
      "VisibilityRecoveryIntervalMilliseconds": 1000,
      "SchedulerIntervalMilliseconds": 1000,
      "BatchSize": 100
    }
  }
}
